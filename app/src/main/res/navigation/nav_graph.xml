<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LoginFragment">

    <fragment
        android:id="@+id/LoginFragment"
        android:name="com.example.memoapp.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_LoginFragment_to_HomeFragment"
            app:destination="@id/HomeFragment" />
    </fragment>

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.example.memoapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_HomeFragment_to_NoteListFragment"
            app:destination="@id/NoteListFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_LogItemListFragment"
            app:destination="@id/LogItemListFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_ConceptListFragment"
            app:destination="@id/ConceptListFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_SymbolListFragment"
            app:destination="@id/SymbolListFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_LoginFragment"
            app:destination="@id/LoginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/NoteListFragment"
        android:name="com.example.memoapp.NoteListFragment"
        android:label="Notes"
        tools:layout="@layout/fragment_note_list" />

    <fragment
        android:id="@+id/LogItemListFragment"
        android:name="com.example.memoapp.LogItemListFragment"
        android:label="LogItems"
        tools:layout="@layout/fragment_log_item_list">
        <action
            android:id="@+id/action_LogItemListFragment_to_LogItemFragment"
            app:destination="@id/LogItemFragment" />
    </fragment>

    <fragment
        android:id="@+id/LogItemFragment"
        android:name="com.example.memoapp.LogItemFragment"
        android:label="LogItem Detail"
        tools:layout="@layout/fragment_log_item">
        <argument
            android:name="logItemId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/ConceptListFragment"
        android:name="com.example.memoapp.ConceptListFragment"
        android:label="Concept List">
        <action
            android:id="@+id/action_ConceptListFragment_to_ConceptFragment"
            app:destination="@id/ConceptFragment" />
    </fragment>

    <fragment
        android:id="@+id/ConceptFragment"
        android:name="com.example.memoapp.ConceptFragment"
        android:label="Concepts">
        <argument
            android:name="conceptId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/SymbolListFragment"
        android:name="com.example.memoapp.SymbolListFragment"
        android:label="Symbols"
        tools:layout="@layout/fragment_symbol_list" />

</navigation>
