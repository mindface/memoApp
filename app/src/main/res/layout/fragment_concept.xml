<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConceptFragment">

    <com.example.memoapp.view.InteractiveCanvasView
        android:id="@+id/canvas_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5" />

    <LinearLayout
        android:id="@+id/toolbar_canvas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_add_rect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_crop"
            android:contentDescription="Add Rectangle" />

        <ImageButton
            android:id="@+id/btn_add_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/presence_online"
            android:contentDescription="Add Circle" />

        <ImageButton
            android:id="@+id/btn_add_text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Add Text" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="#CCCCCC" />

        <ImageButton
            android:id="@+id/btn_save_canvas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_save"
            android:contentDescription="Save Canvas" />

        <ImageButton
            android:id="@+id/btn_clear_canvas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Clear Canvas" />

        <ImageButton
            android:id="@+id/btn_delete_selected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_delete"
            android:visibility="gone"
            android:contentDescription="Delete Selected" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="#CCCCCC" />

        <ImageButton
            android:id="@+id/btn_send_to_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:visibility="gone"
            android:contentDescription="Send to Back" />

        <ImageButton
            android:id="@+id/btn_font_increase"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/btn_plus"
            android:visibility="gone"
            android:contentDescription="Increase Font Size" />

        <ImageButton
            android:id="@+id/btn_font_decrease"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/btn_minus"
            android:visibility="gone"
            android:contentDescription="Decrease Font Size" />

        <ImageButton
            android:id="@+id/btn_edit_text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:visibility="gone"
            android:contentDescription="Edit Text or Size" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="#CCCCCC" />

        <ImageButton
            android:id="@+id/btn_pick_color"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Select Color" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Mode: Pan/Zoom"
        android:background="#80000000"
        android:textColor="@android:color/white"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
